# Copiar como .env únicamente para desarrollo local. No incluir secretos reales
# en este archivo ni subir el .env resultante a Git.

# Opción recomendada: una única URL de conexión.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/tesis_uva

# Secreto JWT. En producción Render lo genera automáticamente.
GRAPESENSE_SECRET_KEY=reemplazar-por-un-valor-aleatorio-largo

# Cuenta global de plataforma. La contraseña debe tener al menos 8 caracteres.
GRAPESENSE_PLATFORM_ADMIN_NAME=Marcos Cassone
GRAPESENSE_PLATFORM_ADMIN_EMAIL=marcos123@gmail.com
GRAPESENSE_PLATFORM_ADMIN_PASSWORD=reemplazar-por-una-contrasena-segura

# Configuración local opcional.
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En local puede omitirse; por defecto se usa app/backend/modelos.
# MODEL_STORAGE_DIR=/ruta/absoluta/a/modelos
